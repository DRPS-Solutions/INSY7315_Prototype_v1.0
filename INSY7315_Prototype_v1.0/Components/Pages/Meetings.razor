@page "/meetings"
@rendermode InteractiveServer
@using MudBlazor

<PageTitle>Meetings</PageTitle>

<style>
    .drps-meeting {
        background: #F4F6FA;
        min-height: calc(100vh - 70px);
        padding-bottom: 2rem;
    }

    .drps-header {
        background: linear-gradient(135deg, #0B1626 0%, #1F3F7A 100%);
        border-radius: 16px;
        padding: 20px 24px;
        color: white;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .drps-card {
        background: #FFFFFF;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 10px rgba(11, 22, 38, 0.06);
        min-height: 70vh;
    }
</style>

<div class="drps-meeting">
    <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6">
        <div class="drps-header">
            <MudText Typo="Typo.h6" Style="font-weight:600;">Meetings Management</MudText>
            @if (!showCreateScreen)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => showCreateScreen = true">
                    + Create Meeting
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Surface" OnClick="() => showCreateScreen = false">
                    Back to Meetings List
                </MudButton>
            }
        </div>

        <div class="drps-card">
            @if (!showCreateScreen)
            {
                @* Table View *@
                <MudTable Items="meetings" Hover="true" Striped="false" Elevation="0">
                    <HeaderContent>
                        <MudTh>Topic / Title</MudTh>
                        <MudTh>Date</MudTh>
                        <MudTh>Time</MudTh>
                        <MudTh>Location</MudTh>
                        <MudTh>Organizer</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Topic"><b>@context.Title</b></MudTd>
                        <MudTd DataLabel="Date">@(context.Date?.ToString("dd MMM yyyy"))</MudTd>
                        <MudTd DataLabel="Time">@(context.Time?.ToString(@"hh\:mm"))</MudTd>
                        <MudTd DataLabel="Location">@context.Location</MudTd>
                        <MudTd DataLabel="Organizer">@context.Organizer</MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                @* Creation Screen *@
                <MudText Typo="Typo.h6" Class="mb-4">Schedule New Meeting</MudText>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="newMeeting.Title" Label="Meeting Topic" Variant="Variant.Outlined" Class="mb-3" />
                        <MudTextField T="string" @bind-Value="newMeeting.Location" Label="Location / Link" Variant="Variant.Outlined" Class="mb-3" />

                        <div class="d-flex gap-3 mb-3">
                            <MudDatePicker @bind-Date="newMeeting.Date" Label="Date" Variant="Variant.Outlined" />
                            <MudTimePicker @bind-Time="newMeeting.Time" Label="Time" Variant="Variant.Outlined" />
                        </div>

                        <MudSelect T="string" Label="Organizer" Variant="Variant.Outlined" @bind-Value="newMeeting.Organizer" Class="mb-4">
                            @foreach (var staff in staffList)
                            {
                                <MudSelectItem Value="@staff">@staff</MudSelectItem>
                            }
                        </MudSelect>

                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveMeeting">Save Meeting</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="() => showCreateScreen = false">Cancel</MudButton>
                        </div>
                    </MudItem>
                </MudGrid>
            }
        </div>
    </MudContainer>
</div>

@code {
    private bool showCreateScreen = false;

    private List<string> staffList = new() { "Naledi Dube", "Sipho Mokoena", "Aisha Patel" };

    private MeetingModel newMeeting = new MeetingModel();

    private List<MeetingModel> meetings = new()
    {
        new MeetingModel { Title = "Q3 Logistics Strategy", Date = DateTime.Today.AddDays(1), Time = new TimeSpan(10, 0, 0), Location = "Boardroom A", Organizer = "Naledi Dube" },
        new MeetingModel { Title = "System Integration Review", Date = DateTime.Today.AddDays(3), Time = new TimeSpan(14, 30, 0), Location = "Teams Meeting", Organizer = "Sipho Mokoena" }
    };

    private void SaveMeeting()
    {
        if (!string.IsNullOrWhiteSpace(newMeeting.Title) && newMeeting.Date.HasValue)
        {
            meetings.Add(newMeeting);
            newMeeting = new MeetingModel();
            showCreateScreen = false;
        }
    }

    private class MeetingModel
    {
        public string Title { get; set; } = string.Empty;
        public DateTime? Date { get; set; } = DateTime.Today;
        public TimeSpan? Time { get; set; } = new TimeSpan(9, 0, 0);
        public string Location { get; set; } = string.Empty;
        public string Organizer { get; set; } = string.Empty;
    }
}
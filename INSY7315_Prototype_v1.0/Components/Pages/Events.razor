@page "/events"
@rendermode InteractiveServer
@using MudBlazor

<PageTitle>Event Planning</PageTitle>

@* =====================================================================
   STYLE BLOCK
   Reuses the standard DRPS navy/blue palette and card conventions
   scoped specifically to the event planning view[cite: 4, 5, 6].
   ===================================================================== *@
<style>
    .drps-events {
        --drps-navy-900: #0B1626;
        --drps-navy-800: #14243B;
        --drps-blue-600: #1F3F7A;
        --drps-blue-500: #2A5CD1;
        --drps-blue-400: #4A7FE8;
        --drps-bg: #F4F6FA;
        --drps-surface: #FFFFFF;
        --drps-text-muted: #6B7A90;
        background: var(--drps-bg);
        min-height: 100%;
        padding-bottom: 2rem;
    }

    .drps-events-header {
        background: linear-gradient(135deg, var(--drps-navy-900) 0%, var(--drps-blue-600) 100%);
        border-radius: 16px;
        padding: 20px 24px;
        color: white;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .drps-card {
        background: var(--drps-surface);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 10px rgba(11, 22, 38, 0.06);
        height: 100%;
    }

    .drps-card-title {
        font-weight: 600;
        color: var(--drps-navy-800);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .drps-event-item {
        border-radius: 8px;
        padding: 12px 16px;
        background: #EEF2FC;
        border-left: 4px solid var(--drps-blue-500);
        margin-bottom: 12px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .drps-event-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--drps-navy-800);
    }

    .drps-event-meta {
        font-size: 0.8rem;
        color: var(--drps-text-muted);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .drps-event-empty {
        color: #C7CEDA;
        font-size: 0.85rem;
        text-align: center;
        padding: 30px 0;
    }
</style>

<div class="drps-events">
    <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6">

        @* Header *@
        <div class="drps-events-header">
            <MudText Typo="Typo.h6" Style="font-weight:600;">Event & Project Planning</MudText>
        </div>

        <MudGrid>
            @* Left Column: Event Creation Form *@
            <MudItem xs="12" md="5">
                <div class="drps-card">
                    <div class="drps-card-title">
                        <MudIcon Icon="@Icons.Material.Filled.AddBox" Size="Size.Small" />
                        Create New Event
                    </div>
                    
                    <MudTextField T="string" @bind-Value="newEvent.Title" Label="Event Title" Variant="Variant.Outlined" Class="mb-3" />
                    <MudTextField T="string" @bind-Value="newEvent.Location" Label="Location" Variant="Variant.Outlined" Class="mb-3" />
                    
                    <div class="d-flex gap-3 mb-3">
                        <MudDatePicker @bind-Date="newEvent.Date" Label="Date" Variant="Variant.Outlined" />
                        <MudTimePicker @bind-Time="newEvent.Time" Label="Time" Variant="Variant.Outlined" />
                    </div>

                    <MudSelect T="string" Label="Lead Coordinator" Variant="Variant.Outlined" @bind-Value="newEvent.Coordinator" Class="mb-4">
                        @foreach (var emp in employees)
                        {
                            <MudSelectItem T="string" Value="@emp">@emp</MudSelectItem>
                        }
                    </MudSelect>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="AddEvent">
                        Schedule Event
                    </MudButton>
                </div>
            </MudItem>

            @* Right Column: Upcoming Events Roster *@
            <MudItem xs="12" md="7">
                <div class="drps-card">
                    <div class="drps-card-title">
                        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" />
                        Upcoming Events
                    </div>

                    @if (!plannedEvents.Any())
                    {
                        <div class="drps-event-empty">No events scheduled yet.</div>
                    }
                    else
                    {
                        @foreach (var evt in plannedEvents.OrderBy(e => e.Date))
                        {
                            <div class="drps-event-item">
                                <div class="drps-event-title">@evt.Title</div>
                                <div class="drps-event-meta">
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
                                    @(evt.Date?.ToString("dd MMM yyyy")) at @(evt.Time?.ToString(@"hh\:mm"))
                                </div>
                                <div class="drps-event-meta">
                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                                    @evt.Location
                                </div>
                                <div class="drps-event-meta">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                    Lead: @evt.Coordinator
                                </div>
                            </div>
                        }
                    }
                </div>
            </MudItem>
        </MudGrid>

    </MudContainer>
</div>

@code {
    // Model for capturing form input
    private EventModel newEvent = new EventModel();
    
    // Roster of established employees pulled from other pages[cite: 4, 6]
    private List<string> employees = new()
    {
        "Naledi Dube",
        "Sipho Mokoena",
        "Aisha Patel",
        "Liam Fourie",
        "Grace Adeyemi"
    };

    // Placeholder list of existing events
    private List<EventModel> plannedEvents = new()
    {
        new EventModel { 
            Title = "Annual Donor Gala", 
            Date = DateTime.Today.AddDays(14), 
            Time = new TimeSpan(18, 0, 0),
            Location = "Cape Town Convention Centre",
            Coordinator = "Aisha Patel"
        }
    };

    private void AddEvent()
    {
        if (!string.IsNullOrWhiteSpace(newEvent.Title) && newEvent.Date.HasValue)
        {
            plannedEvents.Add(new EventModel
            {
                Title = newEvent.Title,
                Date = newEvent.Date,
                Time = newEvent.Time,
                Location = newEvent.Location,
                Coordinator = newEvent.Coordinator
            });
            
            // Reset form
            newEvent = new EventModel();
        }
    }

    private class EventModel
    {
        public string Title { get; set; } = string.Empty;
        public DateTime? Date { get; set; } = DateTime.Today;
        public TimeSpan? Time { get; set; } = new TimeSpan(9, 0, 0);
        public string Location { get; set; } = string.Empty;
        public string Coordinator { get; set; } = string.Empty;
    }
}
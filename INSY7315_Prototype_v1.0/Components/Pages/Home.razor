@page "/"
@rendermode InteractiveServer
@using MudBlazor

<PageTitle>Today's Tasks</PageTitle>

<style>
    .drps-home {
        background: #F4F6FA;
        min-height: calc(100vh - 70px);
        padding-bottom: 2rem;
    }

    .drps-header {
        background: linear-gradient(135deg, #0B1626 0%, #1F3F7A 100%);
        border-radius: 16px;
        padding: 20px 24px;
        color: white;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .drps-card {
        background: #FFFFFF;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 10px rgba(11, 22, 38, 0.06);
        min-height: 70vh;
    }

    .task-item {
        border: 1px solid #EAEFEF;
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 12px;
        background: #FFFFFF;
        transition: background 0.2s ease;
    }

        .task-item.completed {
            background: #F0F9F4;
            border-color: #C6EAD4;
        }
</style>

<div class="drps-home">
    <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6">
        @* Locked Header *@
        <div class="drps-header">
            <div>
                <MudText Typo="Typo.h6" Style="font-weight:600;">Daily Schedule</MudText>
                <MudText Typo="Typo.body2" Style="opacity: 0.85;">
                    @DateTime.Today.ToString("dddd, dd MMMM yyyy")
                </MudText>
            </div>
            <MudChip T="string" Color="Color.Info" Variant="Variant.Filled">Today Only</MudChip>
        </div>

        <div class="drps-card">
            <MudText Typo="Typo.h6" Class="mb-4">Today's Active Tasks</MudText>

            @foreach (var task in todayTasks)
            {
                <div class="task-item @(task.IsCompleted ? "completed" : "")">
                    <MudGrid AlignItems="Center">
                        <MudItem xs="12" sm="1">
                            <MudCheckBox T="bool" @bind-Value="task.IsCompleted" Color="Color.Success" />
                        </MudItem>

                        <MudItem xs="12" sm="5">
                            <MudText Typo="Typo.body1" Style="@(task.IsCompleted ? "text-decoration: line-through; color: #888;" : "font-weight: 500;")">
                                @task.Title
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@task.Category</MudText>
                        </MudItem>

                        <MudItem xs="12" sm="6" Class="d-flex align-center gap-2">
                            <MudSelect T="string"
                                       Label="Completed By"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       @bind-Value="task.CompletedBy"
                                       Disabled="@(!task.IsCompleted)">
                                @foreach (var member in staffMembers)
                                {
                                    <MudSelectItem Value="@member">@member</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </div>
            }
        </div>
    </MudContainer>
</div>

@code {
    private List<string> staffMembers = new()
    {
        "Naledi Dube",
        "Sipho Mokoena",
        "Aisha Patel",
        "Liam Fourie",
        "Grace Adeyemi"
    };

    private List<DailyTask> todayTasks = new()
    {
        new DailyTask { Title = "Review Morning Dispatch Logs", Category = "Operations", IsCompleted = false },
        new DailyTask { Title = "Submit Weekly Safety Checklist", Category = "Compliance", IsCompleted = false },
        new DailyTask { Title = "Confirm Driver Schedules", Category = "Logistics", IsCompleted = false },
        new DailyTask { Title = "Client Status Update Call", Category = "Management", IsCompleted = false }
    };

    private class DailyTask
    {
        public string Title { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public bool IsCompleted { get; set; }
        public string CompletedBy { get; set; } = string.Empty;
    }
}
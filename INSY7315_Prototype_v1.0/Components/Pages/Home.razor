@page "/"
@rendermode InteractiveServer
@using MudBlazor
@implements IDisposable
@inject IDialogService DialogService
@inject AppDataService AppData

<PageTitle>Today's Tasks</PageTitle>

<style>
    .drps-home {
        --drps-navy-800: #1C3D32;
        --drps-blue-500: #3C7A63;
        --drps-blue-400: #6FA98C;
        --drps-bg: #F5F3EC;
        --drps-surface: #FFFFFF;
        --drps-text-muted: #75806F;
        --drps-border-soft: #E7E4D8;
        --drps-tint-green: #E7F3EB;
        --drps-tint-green-border: #A9CDB8;
        --drps-hairline: #F1EEE2;
        --drps-empty: #B7B2A0;
        --drps-shadow: rgba(11, 22, 38, 0.06);
        background: var(--drps-bg);
        min-height: calc(100vh - 70px);
        padding-bottom: 2rem;
    }

    .drps-header {
        background: linear-gradient(135deg, #12271F 0%, #2F5C4C 100%);
        border-radius: 16px;
        padding: 20px 24px;
        color: white;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .drps-card {
        background: var(--drps-surface);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 10px var(--drps-shadow);
        min-height: 70vh;
    }

    .task-item {
        border: 1px solid var(--drps-border-soft);
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 12px;
        background: var(--drps-surface);
        transition: background 0.2s ease;
    }

        .task-item.completed {
            background: var(--drps-tint-green);
            border-color: var(--drps-tint-green-border);
        }

    .drps-modal-task-name {
        font-size: 0.85rem;
        color: var(--drps-text-muted);
        margin-bottom: 16px;
    }

    .drps-summary-card {
        background: var(--drps-surface);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 10px var(--drps-shadow);
        height: 100%;
    }

    .drps-summary-title {
        font-weight: 600;
        color: var(--drps-navy-800);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .drps-summary-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid var(--drps-hairline);
    }

    .drps-summary-item:last-child {
        border-bottom: none;
    }

    .drps-summary-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--drps-blue-400) 0%, var(--drps-blue-500) 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.72rem;
        flex-shrink: 0;
    }

    .drps-summary-task {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--drps-navy-800);
    }

    .drps-summary-by {
        font-size: 0.74rem;
        color: var(--drps-text-muted);
    }

    .drps-summary-empty {
        color: var(--drps-empty);
        font-size: 0.82rem;
        text-align: center;
        padding: 24px 0;
    }

    .drps-event-tag {
        display: inline-block;
        margin-left: 8px;
        padding: 1px 8px;
        border-radius: 999px;
        background: var(--drps-tint-green);
        color: var(--drps-blue-500);
        font-size: 0.68rem;
        font-weight: 600;
        vertical-align: middle;
    }

    /* --- Dark mode overrides --- */
    .page.dark-mode .drps-home {
        --drps-bg: #0B1B21;
        --drps-surface: #1E362B;
        --drps-text-muted: #93A69A;
        --drps-navy-800: #E9F0EA;
        --drps-border-soft: #2E4A3B;
        --drps-tint-green: rgba(46, 158, 91, 0.16);
        --drps-tint-green-border: rgba(46, 158, 91, 0.4);
        --drps-hairline: #2E4A3B;
        --drps-empty: #4E5F52;
        --drps-shadow: rgba(0, 0, 0, 0.35);
    }
</style>

<div class="drps-home">
    <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6">
        @* Locked Header *@
        <div class="drps-header">
            <div>
                <MudText Typo="Typo.h6" Style="font-weight:600;">Daily Schedule</MudText>
                <MudText Typo="Typo.body2" Style="opacity: 0.85;">
                    @DateTime.Today.ToString("dddd, dd MMMM yyyy")
                </MudText>
            </div>
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                @completedCount of @todayTasks.Count completed today
            </MudChip>
        </div>

        <MudGrid>
            <MudItem xs="12" md="8">
                <div class="drps-card">
                    <div class="d-flex align-center justify-space-between mb-4">
                        <MudText Typo="Typo.h6">Today's Active Tasks</MudText>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   Href="tasks">
                            Open Daily Tasks
                        </MudButton>
                    </div>

                    @if (!todayTasks.Any())
                    {
                        <div class="drps-summary-empty">Nothing scheduled for today.</div>
                    }
                    else
                    {
                        @foreach (var task in todayTasks.OrderBy(t => t.ScheduledStart))
                        {
                            <div class="task-item @(task.IsCompleted ? "completed" : "")">
                                <MudGrid AlignItems="Center">
                                    <MudItem xs="12" sm="1">
                                        <MudCheckBox T="bool"
                                                     Value="task.IsCompleted"
                                                     ValueChanged="@(async (bool @checked) => await OnToggleTask(task, @checked))"
                                                     Color="Color.Success" />
                                    </MudItem>

                                    <MudItem xs="12" sm="7">
                                        <MudText Typo="Typo.body1" Style="@(task.IsCompleted ? "text-decoration: line-through; color: #888;" : "font-weight: 500;")">
                                            @task.Title
                                            @if (task.Type == AppTaskType.Event && !string.IsNullOrWhiteSpace(task.LinkedEventTitle))
                                            {
                                                <span class="drps-event-tag">@task.LinkedEventTitle</span>
                                            }
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @(task.IsAllDay ? "All day" : task.ScheduledStart.ToString("h:mm tt")) &middot; @task.Category
                                            @(string.IsNullOrWhiteSpace(task.Assignee) ? "" : $" \u00b7 {task.Assignee}")
                                        </MudText>
                                    </MudItem>

                                    <MudItem xs="12" sm="4">
                                        @if (task.IsCompleted && !string.IsNullOrEmpty(task.CompletedBy))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight:500;">
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                                                Completed by @task.CompletedBy
                                            </MudText>
                                        }
                                    </MudItem>
                                </MudGrid>
                            </div>
                        }
                    }
                </div>
            </MudItem>

            <MudItem xs="12" md="4">
                <div class="drps-summary-card">
                    <div class="drps-summary-title">
                        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" />
                        Completed Today
                    </div>

                    @if (!CompletedTasks.Any())
                    {
                        <div class="drps-summary-empty">Nothing completed yet today</div>
                    }
                    else
                    {
                        @foreach (var task in CompletedTasks)
                        {
                            <div class="drps-summary-item">
                                <div class="drps-summary-avatar">@GetInitials(task.CompletedBy)</div>
                                <div>
                                    <div class="drps-summary-task">@task.Title</div>
                                    <div class="drps-summary-by">@task.CompletedBy &middot; @task.Category</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </MudItem>
        </MudGrid>
    </MudContainer>
</div>

@code {
    // Home is deliberately just a filtered view over the exact same
    // AppTask collection Tasks.razor (Daily Tasks) reads and writes -
    // that's what makes the two pages "linked": ticking a task's box
    // here calls AppData.CompleteTask, which raises AppData.OnChange,
    // which is what makes the Daily Tasks page's own todayTasks/tasks
    // views immediately reflect the change (and vice versa).
    private List<string> staffMembers => AppData.EmployeeNames;

    // Today's tasks only - both Daily tasks and Event-linked tasks
    // scheduled for today, which is what makes this "Today's Active
    // Tasks" rather than the full multi-day schedule Tasks.razor shows.
    private List<AppTask> todayTasks => AppData.TodayTasks.ToList();

    // Number of today's tasks marked complete - drives the header chip.
    private int completedCount => todayTasks.Count(t => t.IsCompleted);

    // Completed tasks (with an attributed staff member) for the
    // admin-facing "Completed Today" panel.
    private IEnumerable<AppTask> CompletedTasks =>
        todayTasks.Where(t => t.IsCompleted && !string.IsNullOrEmpty(t.CompletedBy))
                  .OrderByDescending(t => t.CompletedAt);

    // Checking a task's box opens CompletedByDialog so the completion
    // is attributed to a staff member, mirroring the Daily Tasks page.
    // Unchecking clears completion immediately, no attribution needed.
    private async Task OnToggleTask(AppTask task, bool isChecked)
    {
        if (isChecked)
        {
            var parameters = new DialogParameters<CompletedByDialog>
            {
                { x => x.TaskTitle, task.Title },
                { x => x.Employees, staffMembers }
            };
            var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };

            var dialog = await DialogService.ShowAsync<CompletedByDialog>("Mark task complete", parameters, options);
            var result = await dialog.Result;

            if (result is not null && !result.Canceled && result.Data is string employee && !string.IsNullOrEmpty(employee))
            {
                AppData.CompleteTask(task, employee);
            }
        }
        else
        {
            AppData.ReopenTask(task);
        }
    }

    // Initials for the small avatar badge in the completion summary.
    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        return string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                  .Select(part => part[0]))
                      .ToUpper();
    }

    // Re-render if a task is completed/added elsewhere (e.g. from the
    // Daily Tasks page) while Home is open, so the two pages never
    // show stale, out-of-sync state.
    protected override void OnInitialized()
    {
        AppData.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppData.OnChange -= StateHasChanged;
    }
}
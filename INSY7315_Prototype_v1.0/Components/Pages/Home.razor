@page "/"
@rendermode InteractiveServer
@using MudBlazor
@inject IDialogService DialogService

<PageTitle>Today's Tasks</PageTitle>

<style>
    .drps-home {
        --drps-navy-800: #14243B;
        --drps-blue-500: #2A5CD1;
        --drps-blue-400: #4A7FE8;
        --drps-bg: #F4F6FA;
        --drps-surface: #FFFFFF;
        --drps-text-muted: #6B7A90;
        --drps-border-soft: #EAEFEF;
        --drps-tint-green: #F0F9F4;
        --drps-tint-green-border: #C6EAD4;
        --drps-hairline: #F0F2F7;
        --drps-empty: #C7CEDA;
        --drps-shadow: rgba(11, 22, 38, 0.06);
        background: var(--drps-bg);
        min-height: calc(100vh - 70px);
        padding-bottom: 2rem;
    }

    .drps-header {
        background: linear-gradient(135deg, #0B1626 0%, #1F3F7A 100%);
        border-radius: 16px;
        padding: 20px 24px;
        color: white;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .drps-card {
        background: var(--drps-surface);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 10px var(--drps-shadow);
        min-height: 70vh;
    }

    .task-item {
        border: 1px solid var(--drps-border-soft);
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 12px;
        background: var(--drps-surface);
        transition: background 0.2s ease;
    }

        .task-item.completed {
            background: var(--drps-tint-green);
            border-color: var(--drps-tint-green-border);
        }

    .drps-modal-task-name {
        font-size: 0.85rem;
        color: var(--drps-text-muted);
        margin-bottom: 16px;
    }

    .drps-summary-card {
        background: var(--drps-surface);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 10px var(--drps-shadow);
        height: 100%;
    }

    .drps-summary-title {
        font-weight: 600;
        color: var(--drps-navy-800);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .drps-summary-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid var(--drps-hairline);
    }

    .drps-summary-item:last-child {
        border-bottom: none;
    }

    .drps-summary-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--drps-blue-400) 0%, var(--drps-blue-500) 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.72rem;
        flex-shrink: 0;
    }

    .drps-summary-task {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--drps-navy-800);
    }

    .drps-summary-by {
        font-size: 0.74rem;
        color: var(--drps-text-muted);
    }

    .drps-summary-empty {
        color: var(--drps-empty);
        font-size: 0.82rem;
        text-align: center;
        padding: 24px 0;
    }

    /* --- Dark mode overrides --- */
    .page.dark-mode .drps-home {
        --drps-bg: #0F1B2E;
        --drps-surface: #16233A;
        --drps-text-muted: #8CA0BF;
        --drps-navy-800: #E8ECF5;
        --drps-border-soft: #22314C;
        --drps-tint-green: rgba(46, 158, 91, 0.16);
        --drps-tint-green-border: rgba(46, 158, 91, 0.4);
        --drps-hairline: #22314C;
        --drps-empty: #4C5C79;
        --drps-shadow: rgba(0, 0, 0, 0.35);
    }
</style>

<div class="drps-home">
    <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6">
        @* Locked Header *@
        <div class="drps-header">
            <div>
                <MudText Typo="Typo.h6" Style="font-weight:600;">Daily Schedule</MudText>
                <MudText Typo="Typo.body2" Style="opacity: 0.85;">
                    @DateTime.Today.ToString("dddd, dd MMMM yyyy")
                </MudText>
            </div>
            <MudChip T="string" Color="Color.Info" Variant="Variant.Filled">
                @completedCount of @todayTasks.Count completed today
            </MudChip>
        </div>

        <MudGrid>
            <MudItem xs="12" md="8">
                <div class="drps-card">
                    <MudText Typo="Typo.h6" Class="mb-4">Today's Active Tasks</MudText>

                    @foreach (var task in todayTasks)
                    {
                        <div class="task-item @(task.IsCompleted ? "completed" : "")">
                            <MudGrid AlignItems="Center">
                                <MudItem xs="12" sm="1">
                                    <MudCheckBox T="bool"
                                                 Value="task.IsCompleted"
                                                 ValueChanged="@(async (bool @checked) => await OnToggleTask(task, @checked))"
                                                 Color="Color.Success" />
                                </MudItem>

                                <MudItem xs="12" sm="7">
                                    <MudText Typo="Typo.body1" Style="@(task.IsCompleted ? "text-decoration: line-through; color: #888;" : "font-weight: 500;")">
                                        @task.Title
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@task.Category</MudText>
                                </MudItem>

                                <MudItem xs="12" sm="4">
                                    @if (task.IsCompleted && !string.IsNullOrEmpty(task.CompletedBy))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight:500;">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                                            Completed by @task.CompletedBy
                                        </MudText>
                                    }
                                </MudItem>
                            </MudGrid>
                        </div>
                    }
                </div>
            </MudItem>

            <MudItem xs="12" md="4">
                <div class="drps-summary-card">
                    <div class="drps-summary-title">
                        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" />
                        Completed Today
                    </div>

                    @if (!CompletedTasks.Any())
                    {
                        <div class="drps-summary-empty">Nothing completed yet today</div>
                    }
                    else
                    {
                        @foreach (var task in CompletedTasks)
                        {
                            <div class="drps-summary-item">
                                <div class="drps-summary-avatar">@GetInitials(task.CompletedBy)</div>
                                <div>
                                    <div class="drps-summary-task">@task.Title</div>
                                    <div class="drps-summary-by">@task.CompletedBy &middot; @task.Category</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </MudItem>
        </MudGrid>
    </MudContainer>
</div>

@code {
    private List<string> staffMembers = new()
    {
        "Naledi Dube",
        "Sipho Mokoena",
        "Aisha Patel",
        "Liam Fourie",
        "Grace Adeyemi"
    };

    private List<DailyTask> todayTasks = new()
    {
        new DailyTask { Title = "Review Morning Dispatch Logs", Category = "Operations", IsCompleted = false },
        new DailyTask { Title = "Submit Weekly Safety Checklist", Category = "Compliance", IsCompleted = false },
        new DailyTask { Title = "Confirm Driver Schedules", Category = "Logistics", IsCompleted = false },
        new DailyTask { Title = "Client Status Update Call", Category = "Management", IsCompleted = false }
    };

    private class DailyTask
    {
        public string Title { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public bool IsCompleted { get; set; }
        public string? CompletedBy { get; set; }
    }

    // Number of today's tasks marked complete - drives the header chip.
    private int completedCount => todayTasks.Count(t => t.IsCompleted);

    // Completed tasks (with an attributed staff member) for the
    // admin-facing "Completed Today" panel.
    private IEnumerable<DailyTask> CompletedTasks =>
        todayTasks.Where(t => t.IsCompleted && !string.IsNullOrEmpty(t.CompletedBy));

    // Checking a task's box opens CompletedByDialog so the completion
    // is attributed to a staff member, mirroring the Daily Tasks page.
    // Unchecking clears completion immediately, no attribution needed.
    private async Task OnToggleTask(DailyTask task, bool isChecked)
    {
        if (isChecked)
        {
            var parameters = new DialogParameters<CompletedByDialog>
            {
                { x => x.TaskTitle, task.Title },
                { x => x.Employees, staffMembers }
            };
            var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };

            var dialog = await DialogService.ShowAsync<CompletedByDialog>("Mark task complete", parameters, options);
            var result = await dialog.Result;

            if (result is not null && !result.Canceled && result.Data is string employee && !string.IsNullOrEmpty(employee))
            {
                task.IsCompleted = true;
                task.CompletedBy = employee;
            }
        }
        else
        {
            task.IsCompleted = false;
            task.CompletedBy = null;
        }
    }

    // Initials for the small avatar badge in the completion summary.
    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        return string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                  .Select(part => part[0]))
                      .ToUpper();
    }
}
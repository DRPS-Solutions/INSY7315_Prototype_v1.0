@page "/users"
@rendermode InteractiveServer
@using MudBlazor

<PageTitle>User Management</PageTitle>

<style>
    .drps-users {
        background: #F4F6FA;
        min-height: calc(100vh - 70px);
        padding-bottom: 2rem;
    }

    .drps-header {
        background: linear-gradient(135deg, #0B1626 0%, #1F3F7A 100%);
        border-radius: 16px;
        padding: 20px 24px;
        color: white;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .drps-card {
        background: #FFFFFF;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 10px rgba(11, 22, 38, 0.06);
        min-height: 70vh;
    }
</style>

<div class="drps-users">
    <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6">
        <div class="drps-header">
            <MudText Typo="Typo.h6" Style="font-weight:600;">User Management</MudText>
            @if (!showCreateUserScreen)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => showCreateUserScreen = true">
                    + Add New User
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Surface" OnClick="() => showCreateUserScreen = false">
                    Back to Roster
                </MudButton>
            }
        </div>

        <div class="drps-card">
            @if (!showCreateUserScreen)
            {
                @* User List *@
                <MudTable Items="users" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Email</MudTh>
                        <MudTh>Role</MudTh>
                        <MudTh>Department</MudTh>
                        <MudTh>Status</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name"><b>@context.FullName</b></MudTd>
                        <MudTd DataLabel="Email">@context.Email</MudTd>
                        <MudTd DataLabel="Role">@context.Role</MudTd>
                        <MudTd DataLabel="Department">@context.Department</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Active</MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                @* Create User Screen *@
                <MudText Typo="Typo.h6" Class="mb-4">Create New Account</MudText>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="newUser.FullName" Label="Full Name" Variant="Variant.Outlined" Class="mb-3" />
                        <MudTextField T="string" @bind-Value="newUser.Email" Label="Email Address" Variant="Variant.Outlined" Class="mb-3" />

                        <MudSelect T="string" Label="Role" Variant="Variant.Outlined" @bind-Value="newUser.Role" Class="mb-3">
                            <MudSelectItem Value="@("Administrator")">Administrator</MudSelectItem>
                            <MudSelectItem Value="@("Manager")">Manager</MudSelectItem>
                            <MudSelectItem Value="@("Staff Member")">Staff Member</MudSelectItem>
                        </MudSelect>

                        <MudTextField T="string" @bind-Value="newUser.Department" Label="Department" Variant="Variant.Outlined" Class="mb-4" />

                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateUser">Save User</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="() => showCreateUserScreen = false">Cancel</MudButton>
                        </div>
                    </MudItem>
                </MudGrid>
            }
        </div>
    </MudContainer>
</div>

@code {
    private bool showCreateUserScreen = false;

    private UserModel newUser = new UserModel();

    private List<UserModel> users = new()
    {
        new UserModel { FullName = "Naledi Dube", Email = "naledi@drps.co.za", Role = "Administrator", Department = "Operations" },
        new UserModel { FullName = "Sipho Mokoena", Email = "sipho@drps.co.za", Role = "Manager", Department = "Logistics" },
        new UserModel { FullName = "Aisha Patel", Email = "aisha@drps.co.za", Role = "Staff Member", Department = "Planning" }
    };

    private void CreateUser()
    {
        if (!string.IsNullOrWhiteSpace(newUser.FullName))
        {
            users.Add(newUser);
            newUser = new UserModel();
            showCreateUserScreen = false;
        }
    }

    private class UserModel
    {
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
    }
}
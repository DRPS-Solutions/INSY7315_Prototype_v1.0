@page "/users"
@rendermode InteractiveServer
@using MudBlazor

<PageTitle>User Management</PageTitle>

<style>
    .drps-users {
        --drps-navy-900: #12271F;
        --drps-navy-800: #1C3D32;
        --drps-blue-600: #2F5C4C;
        --drps-blue-500: #3C7A63;
        --drps-blue-400: #6FA98C;
        --drps-bg: #F5F3EC;
        --drps-surface: #FFFFFF;
        --drps-text-muted: #75806F;
        --drps-tint-blue: #EAF2ED;
        --drps-tint-amber: #F6EBD3;
        --drps-tint-red: #FCEEF0;
        --drps-border-soft: #F1EEE2;
        --drps-track: #E7E4D8;
        --drps-hover: #F2EFE4;
        --drps-empty: #B7B2A0;
        --drps-shadow: rgba(11, 22, 38, 0.06);
        background: var(--drps-bg);
        min-height: 100%;
        padding-bottom: 2rem;
    }

    .drps-users-header {
        background: linear-gradient(135deg, var(--drps-navy-900) 0%, var(--drps-blue-600) 100%);
        border-radius: 16px;
        padding: 20px 24px;
        color: white;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .drps-users-search .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.35) !important;
    }

    .drps-users-search .mud-input-slot,
    .drps-users-search input {
        color: white !important;
    }

    .drps-users-search .mud-input-label,
    .drps-users-search .mud-icon-root {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    /* --- Left column: employee roster --- */
    .drps-roster {
        background: var(--drps-surface);
        border-radius: 16px;
        box-shadow: 0 2px 10px var(--drps-shadow);
        overflow: hidden;
    }

    .drps-roster-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        cursor: pointer;
        border-left: 3px solid transparent;
        border-bottom: 1px solid var(--drps-border-soft);
        transition: background 0.15s ease;
    }

    .drps-roster-item:last-child {
        border-bottom: none;
    }

    .drps-roster-item:hover {
        background: var(--drps-hover);
    }

    .drps-roster-item.selected {
        background: var(--drps-tint-blue);
        border-left-color: var(--drps-blue-500);
    }

    .drps-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--drps-blue-400) 0%, var(--drps-blue-500) 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.85rem;
        flex-shrink: 0;
    }

    .drps-avatar.large {
        width: 60px;
        height: 60px;
        font-size: 1.2rem;
    }

    .drps-roster-name {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--drps-navy-800);
    }

    .drps-roster-role {
        font-size: 0.74rem;
        color: var(--drps-text-muted);
    }

    .drps-roster-progress {
        margin-top: 4px;
        height: 4px;
        border-radius: 2px;
        background: var(--drps-track);
        overflow: hidden;
    }

    .drps-roster-progress-bar {
        height: 100%;
        background: var(--drps-blue-500);
        border-radius: 2px;
    }

    /* --- Right column: selected employee detail --- */
    .drps-profile-card {
        background: var(--drps-surface);
        border-radius: 16px;
        padding: 20px 24px;
        box-shadow: 0 2px 10px var(--drps-shadow);
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .drps-profile-name {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--drps-navy-800);
    }

    .drps-profile-role {
        font-size: 0.85rem;
        color: var(--drps-blue-500);
        font-weight: 500;
    }

    .drps-profile-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 6px;
        font-size: 0.78rem;
        color: var(--drps-text-muted);
    }

    .drps-profile-meta span {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    /* --- Stat cards row --- */
    .drps-stats-row {
        display: flex;
        gap: 14px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .drps-stat-card {
        flex: 1;
        min-width: 140px;
        background: var(--drps-surface);
        border-radius: 14px;
        padding: 14px 18px;
        box-shadow: 0 2px 10px var(--drps-shadow);
        border-left: 4px solid var(--drps-blue-500);
    }

    .drps-stat-card.pending {
        border-left-color: #B9862E;
    }

    .drps-stat-card.rate {
        border-left-color: #2E9E5B;
    }

    .drps-stat-value {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--drps-navy-800);
    }

    .drps-stat-label {
        font-size: 0.74rem;
        color: var(--drps-text-muted);
    }

    /* --- Task lists (completed / outstanding) --- */
    .drps-task-columns {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .drps-task-col {
        flex: 1;
        min-width: 260px;
        background: var(--drps-surface);
        border-radius: 16px;
        padding: 18px;
        box-shadow: 0 2px 10px var(--drps-shadow);
    }

    .drps-task-col-title {
        font-weight: 600;
        color: var(--drps-navy-800);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
    }

    .drps-user-task {
        border-radius: 8px;
        padding: 8px 12px;
        background: var(--drps-tint-blue);
        border-left: 4px solid var(--drps-blue-500);
        margin-bottom: 8px;
    }

    .drps-user-task.priority-high { border-left-color: #E0435C; background: var(--drps-tint-red); }
    .drps-user-task.priority-medium { border-left-color: #B9862E; background: var(--drps-tint-amber); }
    .drps-user-task.priority-low { border-left-color: var(--drps-blue-500); background: var(--drps-tint-blue); }

    .drps-user-task.done {
        opacity: 0.6;
    }

    .drps-user-task.done .drps-user-task-title {
        text-decoration: line-through;
    }

    .drps-user-task-title {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--drps-navy-800);
    }

    .drps-user-task-meta {
        font-size: 0.7rem;
        color: var(--drps-text-muted);
        margin-top: 2px;
    }

    .drps-task-col-empty {
        color: var(--drps-empty);
        font-size: 0.8rem;
        text-align: center;
        padding: 20px 0;
    }

    /* --- Create user card styling --- */
    .drps-create-card {
        background: var(--drps-surface);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 10px var(--drps-shadow);
        min-height: 60vh;
    }

    /* --- Dark mode overrides --- */
    .page.dark-mode .drps-users {
        --drps-bg: #0B1B21;
        --drps-surface: #1E362B;
        --drps-text-muted: #93A69A;
        --drps-navy-800: #E9F0EA;
        --drps-tint-blue: rgba(60, 122, 99, 0.16);
        --drps-tint-amber: rgba(185, 134, 46, 0.18);
        --drps-tint-red: rgba(224, 67, 92, 0.16);
        --drps-border-soft: #2E4A3B;
        --drps-track: #2E4A3B;
        --drps-hover: #1E3327;
        --drps-empty: #4E5F52;
        --drps-shadow: rgba(0, 0, 0, 0.35);
    }
</style>

<div class="drps-users">
    <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6">

        @* --- Header: title, search, and action button --- *@
        <div class="drps-users-header">
            <MudText Typo="Typo.h6" Style="font-weight:600;">User Management</MudText>
            
            <div class="d-flex align-center gap-3">
                @if (!showCreateUserScreen)
                {
                    <MudTextField T="string"
                                  @bind-Value="searchTerm"
                                  Placeholder="Search employees..."
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="drps-users-search"
                                  Style="max-width:280px;" />

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => showCreateUserScreen = true">
                        Add New User
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Style="color: white; border-color: rgba(255, 255, 255, 0.5);" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="() => showCreateUserScreen = false">
                        Back to Roster
                    </MudButton>
                }
            </div>
        </div>

        @if (!showCreateUserScreen)
        {
            @* --- ORIGINAL ROSTER & DETAIL VIEW --- *@
            <MudGrid>
                <MudItem xs="12" md="4">
                    <div class="drps-roster">
                        @if (!FilteredEmployees.Any())
                        {
                            <div class="drps-task-col-empty">No employees match your search</div>
                        }
                        else
                        {
                            @foreach (var employee in FilteredEmployees)
                            {
                                <div class="drps-roster-item @(employee == selectedEmployee ? "selected" : "")" @onclick="() => selectedEmployee = employee">
                                    <div class="drps-avatar">@employee.Initials</div>
                                    <div style="flex:1;">
                                        <div class="drps-roster-name">@employee.Name</div>
                                        <div class="drps-roster-role">@employee.Role</div>
                                        <div class="drps-roster-progress">
                                            <div class="drps-roster-progress-bar" style="width:@(employee.CompletionRate)%;"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </MudItem>

                <MudItem xs="12" md="8">
                    @if (selectedEmployee is not null)
                    {
                        <div class="drps-profile-card">
                            <div class="drps-avatar large">@selectedEmployee.Initials</div>
                            <div>
                                <div class="drps-profile-name">@selectedEmployee.Name</div>
                                <div class="drps-profile-role">@selectedEmployee.Role &middot; @selectedEmployee.Department</div>
                                <div class="drps-profile-meta">
                                    <span><MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />@selectedEmployee.Email</span>
                                    <span><MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />Joined @selectedEmployee.JoinDate.ToString("MMMM yyyy")</span>
                                    <span><MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="Size.Small" Style="color:#2E9E5B;" />Active</span>
                                </div>
                            </div>
                        </div>

                        <div class="drps-stats-row">
                            <div class="drps-stat-card">
                                <div class="drps-stat-value">@selectedEmployee.CompletedTasks.Count</div>
                                <div class="drps-stat-label">Tasks completed</div>
                            </div>
                            <div class="drps-stat-card pending">
                                <div class="drps-stat-value">@selectedEmployee.PendingTasks.Count</div>
                                <div class="drps-stat-label">Tasks pending</div>
                            </div>
                            <div class="drps-stat-card rate">
                                <div class="drps-stat-value">@selectedEmployee.CompletionRate%</div>
                                <div class="drps-stat-label">Completion rate</div>
                            </div>
                        </div>

                        <div class="drps-task-columns">
                            <div class="drps-task-col">
                                <div class="drps-task-col-title">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="color:#2E9E5B;" />
                                    Completed
                                </div>
                                @if (!selectedEmployee.CompletedTasks.Any())
                                {
                                    <div class="drps-task-col-empty">Nothing completed yet</div>
                                }
                                else
                                {
                                    @foreach (var task in selectedEmployee.CompletedTasks)
                                    {
                                        <div class="drps-user-task priority-@task.Priority.ToLower() done">
                                            <div class="drps-user-task-title">@task.Title</div>
                                            <div class="drps-user-task-meta">@task.Category &middot; completed @task.DateLabel</div>
                                        </div>
                                    }
                                }
                            </div>

                            <div class="drps-task-col">
                                <div class="drps-task-col-title">
                                    <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Small" Style="color:#B9862E;" />
                                    Still To Do
                                </div>
                                @if (!selectedEmployee.PendingTasks.Any())
                                {
                                    <div class="drps-task-col-empty">All caught up</div>
                                }
                                else
                                {
                                    @foreach (var task in selectedEmployee.PendingTasks)
                                    {
                                        <div class="drps-user-task priority-@task.Priority.ToLower()">
                                            <div class="drps-user-task-title">@task.Title</div>
                                            <div class="drps-user-task-meta">@task.Category &middot; due @task.DateLabel</div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </MudItem>
            </MudGrid>
        }
        else
        {
            @* --- NEW CREATE USER FORM --- *@
            <div class="drps-create-card">
                <MudText Typo="Typo.h6" Style="font-weight:600; color:var(--drps-navy-800);" Class="mb-4">Create New Account</MudText>
                
                <MudGrid Justify="Justify.Center">
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="newUserName" Label="Full Name" Variant="Variant.Outlined" Class="mb-3" />
                        <MudTextField T="string" @bind-Value="newUserEmail" Label="Email Address" Variant="Variant.Outlined" Class="mb-3" />
                        
                        <MudSelect T="string" Label="Role" Variant="Variant.Outlined" @bind-Value="newUserRole" Class="mb-3">
                            <MudSelectItem Value="@("Operations Coordinator")">Operations Coordinator</MudSelectItem>
                            <MudSelectItem Value="@("Fieldwork Lead")">Fieldwork Lead</MudSelectItem>
                            <MudSelectItem Value="@("Programs Manager")">Programs Manager</MudSelectItem>
                            <MudSelectItem Value="@("IT & Systems Support")">IT & Systems Support</MudSelectItem>
                            <MudSelectItem Value="@("Communications Officer")">Communications Officer</MudSelectItem>
                        </MudSelect>

                        <MudTextField T="string" @bind-Value="newUserDepartment" Label="Department" Variant="Variant.Outlined" Class="mb-4" />

                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveUser">Save User</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => showCreateUserScreen = false">Cancel</MudButton>
                        </div>
                    </MudItem>
                </MudGrid>
            </div>
        }

    </MudContainer>
</div>

@code {
    private string searchTerm = string.Empty;
    private bool showCreateUserScreen = false;

    // Create user form fields
    private string newUserName = string.Empty;
    private string newUserEmail = string.Empty;
    private string newUserRole = "Operations Coordinator";
    private string newUserDepartment = "Admin";

    private IEnumerable<Employee> FilteredEmployees =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? employees
            : employees.Where(e =>
                e.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                e.Role.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private Employee? selectedEmployee;

    private List<Employee> employees = new()
    {
        new Employee
        {
            Name = "Naledi Dube",
            Role = "Operations Coordinator",
            Department = "Admin",
            Email = "naledi.dube@drpssolutions.org",
            JoinDate = new DateTime(2024, 3, 1),
            CompletedTasks = new()
            {
                new UserTask { Title = "Volunteer check-in call", Category = "Admin", Priority = "Low", DateLabel = "2 Aug" },
                new UserTask { Title = "Prepare donor report", Category = "Admin", Priority = "Medium", DateLabel = "1 Aug" },
                new UserTask { Title = "Board meeting minutes", Category = "Meeting", Priority = "Medium", DateLabel = "29 Jul" },
            },
            PendingTasks = new()
            {
                new UserTask { Title = "Grant proposal review", Category = "Admin", Priority = "High", DateLabel = "3 Aug" },
                new UserTask { Title = "Renew office lease paperwork", Category = "Admin", Priority = "Medium", DateLabel = "4 Aug" },
            }
        },
        new Employee
        {
            Name = "Sipho Mokoena",
            Role = "Fieldwork Lead",
            Department = "Programs",
            Email = "sipho.mokoena@drpssolutions.org",
            JoinDate = new DateTime(2023, 6, 15),
            CompletedTasks = new()
            {
                new UserTask { Title = "Site visit — Alexandra shelter", Category = "Fieldwork", Priority = "High", DateLabel = "2 Aug" },
                new UserTask { Title = "Inventory count", Category = "Fieldwork", Priority = "Low", DateLabel = "31 Jul" },
            },
            PendingTasks = new()
            {
                new UserTask { Title = "Community workshop setup", Category = "Fieldwork", Priority = "Medium", DateLabel = "3 Aug" },
                new UserTask { Title = "Distribute food parcels", Category = "Fieldwork", Priority = "High", DateLabel = "5 Aug" },
                new UserTask { Title = "Update fieldwork log", Category = "Admin", Priority = "Low", DateLabel = "5 Aug" },
            }
        },
        new Employee
        {
            Name = "Aisha Patel",
            Role = "Programs Manager",
            Department = "Programs",
            Email = "aisha.patel@drpssolutions.org",
            JoinDate = new DateTime(2022, 1, 10),
            CompletedTasks = new()
            {
                new UserTask { Title = "Team stand-up", Category = "Meeting", Priority = "Low", DateLabel = "2 Aug" },
                new UserTask { Title = "Quarterly impact summary", Category = "Admin", Priority = "High", DateLabel = "30 Jul" },
                new UserTask { Title = "Partner check-in call", Category = "Meeting", Priority = "Medium", DateLabel = "28 Jul" },
                new UserTask { Title = "Volunteer roster review", Category = "Admin", Priority = "Low", DateLabel = "27 Jul" },
            },
            PendingTasks = new()
            {
                new UserTask { Title = "Board meeting", Category = "Meeting", Priority = "High", DateLabel = "3 Aug" },
            }
        },
        new Employee
        {
            Name = "Liam Fourie",
            Role = "IT & Systems Support",
            Department = "Operations",
            Email = "liam.fourie@drpssolutions.org",
            JoinDate = new DateTime(2024, 9, 2),
            CompletedTasks = new(),
            PendingTasks = new()
            {
                new UserTask { Title = "Set up new starter accounts", Category = "Admin", Priority = "Medium", DateLabel = "3 Aug" },
                new UserTask { Title = "Back up donor database", Category = "Admin", Priority = "High", DateLabel = "4 Aug" },
            }
        },
        new Employee
        {
            Name = "Grace Adeyemi",
            Role = "Communications Officer",
            Department = "Marketing",
            Email = "grace.adeyemi@drpssolutions.org",
            JoinDate = new DateTime(2023, 11, 20),
            CompletedTasks = new()
            {
                new UserTask { Title = "Newsletter draft", Category = "Admin", Priority = "Medium", DateLabel = "1 Aug" },
            },
            PendingTasks = new()
            {
                new UserTask { Title = "Social media content calendar", Category = "Admin", Priority = "Low", DateLabel = "4 Aug" },
                new UserTask { Title = "Community workshop photos", Category = "Fieldwork", Priority = "Low", DateLabel = "6 Aug" },
            }
        },
    };

    protected override void OnInitialized()
    {
        selectedEmployee = employees.FirstOrDefault();
    }

    private void SaveUser()
    {
        if (string.IsNullOrWhiteSpace(newUserName)) return;

        var created = new Employee
        {
            Name = newUserName,
            Email = newUserEmail,
            Role = newUserRole,
            Department = newUserDepartment,
            JoinDate = DateTime.Today
        };

        employees.Add(created);
        selectedEmployee = created;

        // Reset form
        newUserName = string.Empty;
        newUserEmail = string.Empty;
        showCreateUserScreen = false;
    }

    private class Employee
    {
        public string Name { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public DateTime JoinDate { get; set; }
        public List<UserTask> CompletedTasks { get; set; } = new();
        public List<UserTask> PendingTasks { get; set; } = new();

        public string Initials =>
            string.Concat(Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                               .Select(part => part[0]))
                  .ToUpper();

        public int CompletionRate
        {
            get
            {
                var total = CompletedTasks.Count + PendingTasks.Count;
                return total == 0 ? 0 : (int)Math.Round(CompletedTasks.Count * 100.0 / total);
            }
        }
    }

    private class UserTask
    {
        public string Title { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Priority { get; set; } = string.Empty;
        public string DateLabel { get; set; } = string.Empty;
    }
}
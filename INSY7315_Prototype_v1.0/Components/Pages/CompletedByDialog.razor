@* =====================================================================
   CompletedByDialog
   A small MudBlazor dialog, shown via IDialogService from Tasks.razor
   whenever a task's checkbox is ticked. Asks which employee completed
   the task and returns their name as the dialog result. Cancelling
   returns no result, and Tasks.razor leaves the task unchanged.

   Reuses the ".drps-modal-task-name" style defined in Tasks.razor's
   <style> block - since Blazor doesn't scope plain <style> tags, those
   rules are already global on any page that has Tasks.razor loaded.
   ===================================================================== *@
@using MudBlazor

<MudDialog Style="border-radius:16px;">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:600; color:#14243B;">Mark task complete</MudText>
    </TitleContent>
    <DialogContent>
        <div class="drps-modal-task-name">@TaskTitle</div>
        <MudSelect T="string" Label="Completed by" Variant="Variant.Outlined" @bind-Value="selectedEmployee">
            @foreach (var employee in Employees)
            {
                <MudSelectItem T="string" Value="@employee">@employee</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@string.IsNullOrEmpty(selectedEmployee)"
                   OnClick="Confirm">
            Confirm
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // Auto-injected by MudDialogProvider - lets this component close
    // or cancel itself and hand a result back to the caller.
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    // The task's title, passed in from Tasks.razor for display only.
    [Parameter]
    public string TaskTitle { get; set; } = string.Empty;

    // The list of employees to populate the dropdown, passed in from
    // Tasks.razor (its placeholder staff list).
    [Parameter]
    public List<string> Employees { get; set; } = new();

    // Currently selected employee in the dropdown.
    private string? selectedEmployee;

    // Closes the dialog successfully, returning the chosen employee's
    // name as the result data.
    private void Confirm() => MudDialog.Close(DialogResult.Ok(selectedEmployee));

    // Closes the dialog as cancelled - the caller treats this as "no
    // change", leaving the task's completion state untouched.
    private void Cancel() => MudDialog.Cancel();
}
